FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_CATALOG_API_URL
ARG VITE_CART_API_URL
ARG VITE_RECOMMENDATIONS_API_URL
ARG VITE_CHECKOUT_API_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CATALOG_API_URL=$VITE_CATALOG_API_URL
ENV VITE_CART_API_URL=$VITE_CART_API_URL
ENV VITE_RECOMMENDATIONS_API_URL=$VITE_RECOMMENDATIONS_API_URL
ENV VITE_CHECKOUT_API_URL=$VITE_CHECKOUT_API_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
